# === Application ===
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# === LLM (Local Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# === Embeddings (Local) ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === ChromaDB (Local) ===
CHROMA_DB_DIR=./vector_store
CHROMA_COLLECTION=healthcare_docs

# === RAG Pipeline ===
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
SIMILARITY_THRESHOLD=0.3

# === File Paths ===
UPLOAD_DIR=./data
LOG_DIR=./logs
SLOTS_CONFIG_PATH=./config/slots.json
INTENTS_CONFIG_PATH=./config/intents.json
